HOST=127.0.0.1
PORT=3333
# Required for network demo mode. Username is mlaw. Use a unique 24+ character password.
# Account mode instead requires existing named users and PUBLIC_HTTPS=true for network hosting.
WORKSPACE_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1
DATA_DIR=.data
# Optional DeepSeek V4.1 Flash. Remote API usage is metered.
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-flash
# MODEL_API_KEY=replace-in-private-env-only
# MODEL_THINKING=disabled
# For local Ollama instead: base URL http://127.0.0.1:11434/v1, an installed MODEL_NAME, MODEL_LOCAL=true.
MODEL_LOCAL=false
# Optional NVIDIA service, private network only, user-scoped API token.
AUTO_ONTOLOGY_URL=
AUTO_ONTOLOGY_TOKEN=
# Comma-separated official HTTPS RSS/Atom feeds. No defaults are silently enabled.
LAW_FEED_URLS=
LAW_POLL_MINUTES=0
# Optional private local speech service (see docs/RECEPTION.md).
VOICE_SERVICE_URL=
VOICE_SERVICE_TOKEN=
# Speech process only: fixed (default), designed (optional GPU setup), or explicit legacy kokoro.
# VOICE_ENGINE=fixed
# Scoped token for the later private Asterisk test adapter, 24+ characters.
RECEPTION_BRIDGE_TOKEN=
# Private verified-contact delivery endpoint. Missing settings lock case status.
VERIFICATION_DELIVERY_URL=
VERIFICATION_DELIVERY_TOKEN=
# Optional named staff access for a controlled private pilot.
# Create users with: node scripts/user.mjs add adnan "Adnan Munawar" admin
# Password is entered privately; never commit accounts or credentials.
AUTH_MODE=demo
# Set true only behind working HTTPS. Required for network account mode.
PUBLIC_HTTPS=false

# Optional installed agent runtime for selected-matter drafting. Start Meeting sets this locally.
# AGENT_PYTHON_PATH=/opt/mlaw/.venv/bin/python
